<h1>Servicios disponibles</h1>

{{#if services.length}}
    {{#each services}}
      <article>
        <h2>{{name}}</h2>
        <p>{{description}}</p>
        <p>Duración: {{duration}} minutos</p>
        <p>Precio: ${{price}}</p>
        <p>Categoría: {{category}}</p>
        <p class="badge">Disponible: {{available}}</p>
      </article>
    {{/each}}
{{else}}
    <p>No hay servicios cargados.</p>
{{/if}}